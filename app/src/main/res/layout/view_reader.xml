<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- 未进入阅读时的落地页：标题 + 上次阅读卡片 / 空态 / 错误态 -->
    <ScrollView
        android:id="@+id/sv_reader_landing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_20"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_32">

            <TextView
                android:id="@+id/tv_reader_title"
                style="@style/TextAppearance.ZL.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reader_title" />

            <!-- 有可恢复的上次阅读记录 -->
            <LinearLayout
                android:id="@+id/ll_reader_last_card"
                style="@style/Widget.ZL.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_reader_book"
                    style="@style/TextAppearance.ZL.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/tv_reader_last_caption"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/reader_last_caption" />

                <TextView
                    android:id="@+id/btn_reader_continue"
                    style="@style/Widget.ZL.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="@string/reader_continue" />
            </LinearLayout>

            <!-- 没有任何阅读记录 -->
            <LinearLayout
                android:id="@+id/ll_reader_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_book"
                    android:tint="@color/divider" />

                <TextView
                    android:id="@+id/tv_reader_empty_title"
                    style="@style/TextAppearance.ZL.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:text="@string/reader_empty_title" />

                <TextView
                    android:id="@+id/tv_reader_empty_desc"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:text="@string/reader_empty_desc" />

                <TextView
                    android:id="@+id/btn_reader_go_library"
                    style="@style/Widget.ZL.GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="@dimen/space_24"
                    android:minWidth="120dp"
                    android:text="@string/go_library" />
            </LinearLayout>

            <!-- 打开失败 -->
            <LinearLayout
                android:id="@+id/ll_reader_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/divider" />

                <TextView
                    android:id="@+id/tv_reader_error_title"
                    style="@style/TextAppearance.ZL.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center"
                    android:text="@string/reader_error_title" />

                <TextView
                    android:id="@+id/tv_reader_error_desc"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:text="@string/reader_error_desc" />

                <TextView
                    android:id="@+id/btn_reader_retry"
                    style="@style/Widget.ZL.GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="@dimen/space_24"
                    android:minWidth="120dp"
                    android:text="@string/action_retry" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 沉浸阅读 -->
    <FrameLayout
        android:id="@+id/fl_reader_reading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/card"
        android:visibility="gone">

        <WebView
            android:id="@+id/wv_reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/pb_reader"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/btn_reader_exit"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_12"
            android:background="@drawable/bg_reader_exit"
            android:contentDescription="@string/reader_exit"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_16">

            <ImageView
                android:layout_width="@dimen/icon_action"
                android:layout_height="@dimen/icon_action"
                android:contentDescription="@null"
                android:src="@drawable/ic_back"
                android:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:text="@string/reader_exit"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
