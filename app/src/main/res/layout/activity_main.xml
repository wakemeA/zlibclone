<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/fl_main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/v_nav_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/ll_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_4">

        <LinearLayout
            android:id="@+id/nav_item_library"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:contentDescription="@string/tab_library"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_library"
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_library"
                android:tint="@color/ink_secondary" />

            <TextView
                android:id="@+id/tv_nav_library"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_library"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_mybooks"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:contentDescription="@string/tab_mybooks"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_mybooks"
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_mybooks"
                android:tint="@color/ink_secondary" />

            <TextView
                android:id="@+id/tv_nav_mybooks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_mybooks"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_reader"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:contentDescription="@string/tab_reader"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_reader"
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_reader"
                android:tint="@color/ink_secondary" />

            <TextView
                android:id="@+id/tv_nav_reader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_reader"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_item_profile"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:contentDescription="@string/tab_profile"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_profile"
                android:layout_width="@dimen/icon_nav"
                android:layout_height="@dimen/icon_nav"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_profile"
                android:tint="@color/ink_secondary" />

            <TextView
                android:id="@+id/tv_nav_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_profile"
                android:textColor="@color/ink_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
