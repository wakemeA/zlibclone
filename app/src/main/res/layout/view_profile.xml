<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sv_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:id="@+id/tv_profile_title"
            style="@style/TextAppearance.ZL.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/profile_title" />

        <!-- 账户卡：左侧内容 + 右上角刷新 -->
        <LinearLayout
            android:id="@+id/ll_account_card"
            style="@style/Widget.ZL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_16"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/fl_account_body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/ll_account_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_account_avatar"
                        style="@style/TextAppearance.ZL.Section"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_avatar"
                        android:gravity="center"
                        android:textColor="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_account_name"
                            style="@style/TextAppearance.ZL.Section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/tv_account_email"
                            style="@style/TextAppearance.ZL.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_account_membership"
                        style="@style/TextAppearance.ZL.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="@dimen/space_8"
                        android:paddingTop="@dimen/space_4"
                        android:paddingEnd="@dimen/space_8"
                        android:paddingBottom="@dimen/space_4"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_account_skeleton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_skeleton" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_12"
                            android:layout_marginEnd="@dimen/space_32"
                            android:background="@drawable/bg_skeleton" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_12"
                            android:layout_marginTop="@dimen/space_8"
                            android:layout_marginEnd="@dimen/screen_margin"
                            android:background="@drawable/bg_skeleton" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_account_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_account_error"
                        style="@style/TextAppearance.ZL.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_load_error" />

                    <TextView
                        android:id="@+id/btn_account_retry"
                        style="@style/Widget.ZL.GhostButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginTop="@dimen/space_12"
                        android:minWidth="120dp"
                        android:text="@string/action_retry" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_account_logged_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_account_not_logged_in"
                        style="@style/TextAppearance.ZL.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_not_logged_in" />

                    <TextView
                        android:id="@+id/tv_account_not_logged_in_desc"
                        style="@style/TextAppearance.ZL.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/account_not_logged_in_desc" />

                    <TextView
                        android:id="@+id/btn_account_login"
                        style="@style/Widget.ZL.GhostButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginTop="@dimen/space_12"
                        android:minWidth="120dp"
                        android:text="@string/account_login" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/btn_account_refresh"
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="@dimen/touch_min"
                android:minHeight="@dimen/touch_min"
                android:paddingStart="@dimen/space_8"
                android:paddingEnd="@dimen/space_8"
                android:text="@string/action_refresh"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_quota_section"
            style="@style/TextAppearance.ZL.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginEnd="@dimen/screen_margin"
            android:text="@string/quota_section" />

        <!-- 今日下载额度：downloads_today 已用、downloads_limit 上限 -->
        <LinearLayout
            android:id="@+id/ll_quota_card"
            style="@style/Widget.ZL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_quota_number"
                    style="@style/TextAppearance.ZL.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quota_unknown"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/btn_quota_refresh"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_min"
                    android:minWidth="@dimen/touch_min"
                    android:paddingStart="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:text="@string/action_refresh"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_quota_used"
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <ProgressBar
                android:id="@+id/pb_quota"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="@dimen/space_12"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/divider"
                android:progressTint="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_settings_section"
            style="@style/TextAppearance.ZL.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginEnd="@dimen/screen_margin"
            android:text="@string/settings_section" />

        <LinearLayout
            android:id="@+id/ll_settings_card"
            style="@style/Widget.ZL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="vertical"
            android:padding="0dp">

            <LinearLayout
                android:id="@+id/rl_setting_server"
                style="@style/Widget.ZL.SettingRow"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_min"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_setting_server"
                        style="@style/TextAppearance.ZL.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_server" />

                    <TextView
                        android:id="@+id/tv_setting_server_desc"
                        style="@style/TextAppearance.ZL.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/setting_server_desc" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_setting_server_value"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/primary" />

                <ImageView
                    android:layout_width="@dimen/icon_action"
                    android:layout_height="@dimen/icon_action"
                    android:layout_marginStart="@dimen/space_4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/rl_setting_language"
                style="@style/Widget.ZL.SettingRow"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/touch_min"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_setting_language"
                        style="@style/TextAppearance.ZL.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_language" />

                    <TextView
                        android:id="@+id/tv_setting_language_desc"
                        style="@style/TextAppearance.ZL.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/setting_language_desc" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_setting_language_value"
                    style="@style/TextAppearance.ZL.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/primary" />

                <ImageView
                    android:layout_width="@dimen/icon_action"
                    android:layout_height="@dimen/icon_action"
                    android:layout_marginStart="@dimen/space_4"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_secondary" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_profile_logout"
            style="@style/TextAppearance.ZL.Body"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/space_12"
            android:text="@string/logout"
            android:textColor="@color/danger" />
    </LinearLayout>
</ScrollView>
