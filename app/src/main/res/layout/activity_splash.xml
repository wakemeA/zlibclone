<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_24">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/iv_splash_logo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_launcher" />

    <TextView
        style="@style/TextAppearance.ZL.PageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/app_name" />

    <TextView
        style="@style/TextAppearance.ZL.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/splash_subtitle" />

    <ProgressBar
        android:id="@+id/pb_splash"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32" />

    <TextView
        android:id="@+id/tv_splash_status"
        style="@style/TextAppearance.ZL.BodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:text="@string/splash_connecting" />

    <LinearLayout
        android:id="@+id/ll_splash_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_splash_error"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/splash_failed"
            android:textColor="@color/danger" />

        <EditText
            android:id="@+id/et_splash_server"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_search"
            android:hint="@string/splash_server_hint"
            android:inputType="textUri"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:singleLine="true"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_splash_retry"
                style="@style/Widget.ZL.GhostButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_weight="1"
                android:text="@string/splash_retry" />

            <TextView
                android:id="@+id/btn_splash_manual"
                style="@style/Widget.ZL.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:text="@string/splash_manual_apply" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
