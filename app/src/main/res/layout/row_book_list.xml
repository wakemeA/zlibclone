<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_row_book"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <ImageView
        android:id="@+id/iv_row_cover"
        android:layout_width="@dimen/cover_width_list"
        android:layout_height="@dimen/cover_height_list"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@string/cover_desc"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_row_title"
            style="@style/TextAppearance.ZL.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_row_author"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_row_status"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_pill"
            android:paddingStart="@dimen/space_8"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_8"
            android:paddingBottom="@dimen/space_4"
            android:textColor="@color/primary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_row_more"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_gravity="center_vertical"
        android:background="@color/transparent"
        android:contentDescription="@string/item_more"
        android:padding="@dimen/space_12"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more"
        android:tint="@color/ink_secondary" />
</LinearLayout>
