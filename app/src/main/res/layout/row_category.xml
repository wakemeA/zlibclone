<?xml version="1.0" encoding="utf-8"?>
<!-- 分类目录行：中文名 + 英文原名/说明 + 数量 + 箭头。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_12">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_row_category_title"
            style="@style/TextAppearance.ZL.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tv_row_category_subtitle"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_row_category_count"
        style="@style/TextAppearance.ZL.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/iv_row_category_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/space_8"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:tint="@color/ink_secondary" />
</LinearLayout>
