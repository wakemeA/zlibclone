<?xml version="1.0" encoding="utf-8"?>
<!-- 书库页：标题 + 搜索框 + 榜单分段 + 书封网格（四态：骨架/空/无结果/失败）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_library_title"
        style="@style/TextAppearance.ZL.PageTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_20"
        android:layout_marginEnd="0dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/library_title" />

    <LinearLayout
        android:id="@+id/ll_library_search_box"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingEnd="@dimen/space_12">

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="@dimen/icon_action"
            android:layout_height="@dimen/icon_action"
            android:layout_marginEnd="@dimen/space_8"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            android:tint="@color/ink_secondary" />

        <EditText
            android:id="@+id/et_library_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/transparent"
            android:gravity="center_vertical"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_secondary"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btn_library_clear"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="@color/transparent"
            android:contentDescription="@string/search_clear"
            android:padding="@dimen/space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_clear"
            android:tint="@color/ink_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_library_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="@dimen/touch_min"
            android:paddingStart="@dimen/space_8"
            android:paddingEnd="@dimen/space_8"
            android:text="@string/search_submit"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_library_segments"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/screen_margin"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_seg_popular"
            style="@style/Widget.ZL.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/segment_popular" />

        <TextView
            android:id="@+id/tv_seg_categories"
            style="@style/Widget.ZL.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/segment_categories" />

        <TextView
            android:id="@+id/tv_seg_liked"
            style="@style/Widget.ZL.Segment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/segment_liked" />
    </LinearLayout>



    <FrameLayout
        android:id="@+id/fl_library_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_12"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gv_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@color/transparent"
            android:clipToPadding="false"
            android:horizontalSpacing="@dimen/space_12"
            android:listSelector="@color/transparent"
            android:numColumns="2"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_20"
            android:scrollbars="none"
            android:stretchMode="columnWidth"
            android:verticalSpacing="@dimen/space_12" />


        <!-- 首屏骨架：2 行 × 2 格，进入页面/重置加载时显示。 -->
        <LinearLayout
            android:id="@+id/ll_library_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </LinearLayout>

        <!-- 空态：榜单无书 / 搜索无结果（文案与按钮由代码切换）。 -->
        <LinearLayout
            android:id="@+id/ll_library_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_book"
                android:tint="@color/divider" />

            <TextView
                android:id="@+id/tv_library_empty_title"
                style="@style/TextAppearance.ZL.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/library_empty_title" />

            <TextView
                android:id="@+id/tv_library_empty_desc"
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/library_empty_desc" />

            <TextView
                android:id="@+id/btn_library_empty_action"
                style="@style/Widget.ZL.GhostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_24"
                android:minWidth="120dp"
                android:text="@string/action_refresh" />
        </LinearLayout>

        <!-- 失败态：请求失败时展示，按钮重试当前榜单/搜索。 -->
        <LinearLayout
            android:id="@+id/ll_library_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_32"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                android:tint="@color/divider" />

            <TextView
                android:id="@+id/tv_library_error_title"
                style="@style/TextAppearance.ZL.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/library_error_title" />

            <TextView
                android:id="@+id/tv_library_error_desc"
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center"
                android:text="@string/error_network_desc" />

            <TextView
                android:id="@+id/btn_library_error_retry"
                style="@style/Widget.ZL.GhostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/space_24"
                android:minWidth="120dp"
                android:text="@string/action_retry" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_library_loading_more"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center"
            android:padding="@dimen/space_12"
            android:text="@string/loading_more"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
