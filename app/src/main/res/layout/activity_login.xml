<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sv_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/ll_login_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_32"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_32">

        <TextView
            style="@style/TextAppearance.ZL.PageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title" />

        <TextView
            style="@style/TextAppearance.ZL.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/login_subtitle" />

        <LinearLayout
            style="@style/Widget.ZL.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email" />

            <EditText
                android:id="@+id/et_login_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_search"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:singleLine="true"
                android:textSize="15sp" />

            <TextView
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/password" />

            <EditText
                android:id="@+id/et_login_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/bg_search"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:singleLine="true"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/server_address" />

        <EditText
            android:id="@+id/et_login_server"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_search"
            android:hint="@string/splash_server_hint"
            android:inputType="textUri"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_login"
            style="@style/Widget.ZL.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/login_button" />

        <ProgressBar
            android:id="@+id/pb_login"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_login_error"
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/danger"
            android:visibility="gone" />

        <TextView
            style="@style/TextAppearance.ZL.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/login_tip" />
    </LinearLayout>
</ScrollView>
