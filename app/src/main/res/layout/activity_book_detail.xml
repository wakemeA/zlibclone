<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- 顶部返回栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <ImageButton
            android:id="@+id/btn_detail_back"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <TextView
            style="@style/TextAppearance.ZL.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:text="@string/detail_title" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_detail_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ll_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_32">

            <ImageView
                android:id="@+id/iv_detail_cover"
                android:layout_width="140dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_cover_placeholder"
                android:contentDescription="@string/cover_desc"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tv_detail_title"
                style="@style/TextAppearance.ZL.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:maxLines="3" />

            <TextView
                android:id="@+id/tv_detail_author"
                style="@style/TextAppearance.ZL.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />

            <TextView
                android:id="@+id/tv_detail_meta"
                style="@style/TextAppearance.ZL.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_16"
                android:background="@color/divider" />

            <TextView
                android:id="@+id/tv_detail_desc_label"
                style="@style/TextAppearance.ZL.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/detail_desc_label" />

            <TextView
                android:id="@+id/tv_detail_desc"
                style="@style/TextAppearance.ZL.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_detail_save"
                    style="@style/Widget.ZL.GhostButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:text="@string/save_book" />

                <TextView
                    android:id="@+id/btn_detail_download"
                    style="@style/Widget.ZL.PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:text="@string/download" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_detail_read"
                style="@style/Widget.ZL.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/read_online" />

            <ProgressBar
                android:id="@+id/pb_detail"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
